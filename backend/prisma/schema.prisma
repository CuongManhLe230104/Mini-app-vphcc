// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// NGƯỜI DÙNG VÀ XÁC THỰC
// ============================================================

/// Vai trò cán bộ quản trị
enum AdminRole {
  SUPER_ADMIN // Quản trị viên cấp cao
  EDITOR // Biên tập viên: soạn bài
  REVIEWER // Người duyệt: duyệt và đăng bài
  HANDLER // Cán bộ xử lý phản ánh
  COUNTER_STAFF // Cán bộ quầy: vận hành hàng chờ/lịch hẹn của quầy được phân công
}

/// Người dân — xác thực qua Zalo
model Citizen {
  id           String        @id @default(uuid())
  zaloId       String        @unique
  name         String?       @db.Text
  avatar       String?       @db.Text
  phone        String? // Giải mã từ token ở backend, không do client gửi
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  feedbacks    Feedback[]
  tickets      QueueTicket[]
  appointments Appointment[]
}

/// Cán bộ — đăng nhập riêng (không qua Zalo)
model Admin {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  fullName     String    @db.Text
  role         AdminRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Quan hệ
  authoredPosts   Post[]          @relation("PostAuthor")
  reviewedPosts   Post[]          @relation("PostReviewer")
  authoredNotices Notice[]        @relation("NoticeAuthor")
  reviewedNotices Notice[]        @relation("NoticeReviewer")
  verifiedNotices Notice[]        @relation("NoticeVerifier")
  handledFeedback        Feedback[]               @relation("FeedbackHandler")
  feedbackReplies        FeedbackReply[]
  assignedCitizenFeedback CitizenFeedback[]        @relation("CitizenFeedbackAssignee")
  citizenFeedbackActions CitizenFeedbackHistory[] @relation("CitizenFeedbackActor")
  auditLogs              AuditLog[]
  counterStaff           CounterStaff[]
}

// ============================================================
// THÔNG TIN TRUNG TÂM
// ============================================================

/// Thông tin Trung tâm Phục vụ hành chính công
model Center {
  id               String   @id @default(uuid())
  name             String   @db.Text
  fullName         String   @db.Text
  address          String   @db.Text
  hotline          String
  oaId             String?
  servicePortalUrl String?  @db.Text
  caseTrackingUrl  String?  @db.Text
  workingHours     Json // [{ day: string, hours: string }]
  bannerImages     Json? // [{ url: string, alt: string }]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================================
// THỦ TỤC HÀNH CHÍNH
// ============================================================

/// Lĩnh vực thủ tục
model ProcedureField {
  id             String        @id @default(uuid())
  slug           String        @unique // vd: "civil", "residence", "land"
  label          String // vd: "Hộ tịch", "Cư trú"
  sortOrder      Int           @default(0)
  procedures     Procedure[]
  counterMapping CounterField?
  createdAt      DateTime      @default(now())
}

/// Thủ tục hành chính
model Procedure {
  id           String         @id @default(uuid())
  code         String? // Mã thủ tục (nếu có)
  name         String         @db.Text
  fieldId      String
  field        ProcedureField @relation(fields: [fieldId], references: [id])
  authority    String         @db.Text // Cơ quan thực hiện
  deadline     String         @db.Text // Thời hạn giải quyết
  fee          String         @db.Text // Lệ phí
  components   Json // Mảng thành phần hồ sơ: string[]
  submission   String         @db.Text // Cách thức nộp
  sourceUrl    String?        @db.Text // Nguồn chính thức
  reviewDate   DateTime? // Ngày rà soát
  isValid      Boolean        @default(true)
  sortOrder    Int            @default(0)
  queueTickets QueueTicket[]
  appointments Appointment[]
  noticeLinks  ProcedureNoticeLink[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

// ============================================================
// TIN TỨC, HƯỚNG DẪN, VIDEO, FAQ
// ============================================================

/// Loại bài viết
enum PostType {
  NEWS // Tin tức
  GUIDE // Hướng dẫn
  VIDEO // Video
}

/// Trạng thái bài viết — quy trình duyệt
enum PostStatus {
  DRAFT // Nháp
  PENDING // Chờ duyệt
  PUBLISHED // Đã đăng
  REJECTED // Từ chối
  ARCHIVED // Lưu trữ
}

/// Bài viết (tin tức, hướng dẫn, video)
model Post {
  id            String     @id @default(uuid())
  type          PostType
  status        PostStatus @default(DRAFT)
  title         String     @db.Text
  summary       String?    @db.Text
  content       String     @db.Text
  thumbnail     String?    @db.Text
  videoUrl      String?    @db.Text
  tags          Json       @default("[]")
  isHighlighted Boolean    @default(false)

  // Bản sửa tách khỏi nội dung đang công khai; version chống ghi đè đồng thời.
  revision         Json?
  revisionStatus   PostStatus?
  revisionAuthorId String?
  version          Int         @default(0)

  // Quy trình duyệt
  authorId      String
  author        Admin     @relation("PostAuthor", fields: [authorId], references: [id])
  reviewerId    String?
  reviewer      Admin?    @relation("PostReviewer", fields: [reviewerId], references: [id])
  rejectionNote String?   @db.Text // Lý do từ chối
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Câu hỏi thường gặp — FAQ được duyệt
model Faq {
  id          String   @id @default(uuid())
  question    String   @db.Text
  answer      String   @db.Text
  category    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// NIÊM YẾT CÔNG KHAI (V2 — Thư viện văn bản & Liên kết TTHC)
// ============================================================

/// Phân nhóm niêm yết công khai
enum NoticeType {
  PROCEDURE_ANNOUNCEMENT // Công bố TTHC hoặc danh mục TTHC
  INTERNAL_PROCESS // Quy trình nội bộ, quy trình điện tử giải quyết TTHC
  INTERNAL_PROCEDURE // TTHC nội bộ trong hệ thống hành chính nhà nước
}

/// Trạng thái xuất bản niêm yết (trục 1: nháp -> chờ duyệt -> đã đăng -> thu hồi)
enum NoticePublicationStatus {
  DRAFT // Nháp
  PENDING // Chờ duyệt
  PUBLISHED // Đã đăng công khai
  REVOKED // Đã thu hồi / ẩn công khai
}

/// Trạng thái hiệu lực pháp lý của quyết định dẫn chiếu (trục 2: tách biệt với trạng thái xuất bản)
enum NoticeLegalStatus {
  UNVERIFIED // Chưa xác minh hiệu lực (mặc định khi nhập từ nguồn)
  VALID // Còn hiệu lực
  PARTIALLY_EXPIRED // Hết hiệu lực một phần / bãi bỏ một phần
  EXPIRED // Hết hiệu lực toàn bộ
}

/// Cờ chất lượng của tệp nguồn kiểm kê
enum SourceQualityStatus {
  UNCHECKED // Chưa kiểm tra
  OK // Khớp thông tin trích xuất cơ bản
  DUPLICATE_CANDIDATE // Nghi trùng văn bản (vd: nguồn 42 và 43)
  CONFLICT // Xung đột thông tin bên trong tệp (vd: nguồn 22: 4811 vs 5116)
  NEEDS_VERIFICATION // Cần đối chiếu ngày/bản gốc đặc biệt (vd: nguồn 1, 31)
}

/// Tác động của quyết định niêm yết lên thủ tục hành chính
enum ProcedureImpactType {
  NEW // Mới ban hành
  AMENDED // Sửa đổi, bổ sung
  REPLACED // Thay thế
  REPEALED // Bãi bỏ
  INTERNAL_PROCESS // Ban hành/tái cấu trúc quy trình nội bộ, điện tử
}

/// Nguồn tài liệu gốc (53 link Google Drive hoặc tệp PDF tải lên)
model SourceDocument {
  id                  String              @id @default(uuid())
  sourceIndex         Int?                @unique // Thứ tự kiểm kê 1..53
  driveFileId         String?             @unique @db.VarChar(120)
  originalUrl         String              @db.Text
  previewUrl          String?             @db.Text
  headerCode          String?             @db.VarChar(120)
  title               String              @db.Text
  innerDecisionTitle  String?             @db.Text
  article1Excerpt     String?             @db.Text
  citedDateText       String?             @db.VarChar(160)
  extractedTextHash   String?             @db.VarChar(128)
  connectorReadable   Boolean             @default(true)
  publicAccessChecked Boolean             @default(false)
  publicAccessOk      Boolean?
  qualityStatus       SourceQualityStatus @default(UNCHECKED)
  qualityNote         String?             @db.Text
  needsDateVerification Boolean           @default(false)
  duplicateOfIndex    Int?
  isPrimaryInGroup    Boolean             @default(true)
  noticeId            String?
  notice              Notice?             @relation(fields: [noticeId], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([noticeId])
  @@index([qualityStatus])
}

/// Niêm yết công khai
model Notice {
  id          String           @id @default(uuid())
  title       String           @db.Text
  description String           @db.Text
  summary     String?          @db.Text // Tóm tắt ngắn Điều 1 / phạm vi niêm yết
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean          @default(true)

  // Metadata thông báo của Trung tâm & Quyết định dẫn chiếu
  noticeNumber        String?                 @db.VarChar(120) // Số thông báo của Trung tâm (nếu có)
  noticeDate          DateTime?               // Ngày thông báo của Trung tâm
  publishingUnit      String?                 @db.Text         // Đơn vị niêm yết (mặc định Trung tâm PVHCC xã Nghĩa Thành)
  noticeType          NoticeType              @default(PROCEDURE_ANNOUNCEMENT)
  publicationStatus   NoticePublicationStatus @default(PUBLISHED)
  legalDocumentNumber String?                 @db.VarChar(160) // Số quyết định (vd: 5119/QĐ-UBND)
  legalDocumentDate   DateTime?               // Ngày ban hành quyết định
  citedDateText       String?                 @db.VarChar(160) // Chuỗi ngày trích từ thông báo
  issuingAuthority    String?                 @db.Text         // Cơ quan ban hành (vd: Chủ tịch UBND TP.HCM)
  managingAuthority   String?                 @db.Text         // Cơ quan quản lý lĩnh vực (vd: Sở Xây dựng)
  legalStatus         NoticeLegalStatus       @default(UNVERIFIED)
  fieldTags           Json                    @default("[]")   // Danh sách lĩnh vực (mảng chuỗi)
  sourcePortalUrl     String?                 @db.Text         // Cổng DVC hoặc Cổng TTĐT dẫn chiếu

  // Xác minh & kiểm soát chất lượng trước khi công khai
  needsVerification   Boolean   @default(false)
  verificationNote    String?   @db.Text
  verifiedById        String?
  verifiedBy          Admin?    @relation("NoticeVerifier", fields: [verifiedById], references: [id])
  verifiedAt          DateTime?

  // Quy trình biên tập / duyệt & bản sửa (revision) cho niêm yết đã đăng
  authorId         String?
  author           Admin?                   @relation("NoticeAuthor", fields: [authorId], references: [id])
  reviewerId       String?
  reviewer         Admin?                   @relation("NoticeReviewer", fields: [reviewerId], references: [id])
  rejectionNote    String?                  @db.Text
  publishedAt      DateTime?
  revokedAt        DateTime?
  revokedReason    String?                  @db.Text
  revision         Json?
  revisionStatus   NoticePublicationStatus?
  revisionAuthorId String?
  version          Int                      @default(0)

  documents      NoticeDocument[]
  sources        SourceDocument[]
  procedureLinks ProcedureNoticeLink[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([publicationStatus, noticeType])
  @@index([legalDocumentNumber])
}

/// Tài liệu đính kèm niêm yết
model NoticeDocument {
  id        String   @id @default(uuid())
  noticeId  String
  notice    Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  name      String   @db.Text
  fileUrl   String   @db.Text
  fileSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())
}

/// Liên kết giữa Thủ tục hành chính và Niêm yết công khai (Mốc NY3)
model ProcedureNoticeLink {
  id                  String              @id @default(uuid())
  procedureId         String
  procedure           Procedure           @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  noticeId            String
  notice              Notice              @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  impactType          ProcedureImpactType @default(AMENDED)
  receivingAuthority  String?             @db.VarChar(255) // Cơ quan tiếp nhận (vd: Trung tâm PVHCC xã Nghĩa Thành / Sở ngành)
  resolvingAuthority  String?             @db.VarChar(255) // Cơ quan giải quyết
  acceptsAtCenter     Boolean             @default(true)   // Có tiếp nhận tại Trung tâm xã Nghĩa Thành không
  note                String?             @db.Text
  createdAt           DateTime            @default(now())

  @@unique([procedureId, noticeId])
  @@index([noticeId])
}

// ============================================================
// PHẢN ÁNH KIẾN NGHỊ
// ============================================================

/// Trạng thái phản ánh
enum FeedbackStatus {
  SUBMITTED // Đã gửi
  RECEIVED // Đã tiếp nhận
  PROCESSING // Đang xử lý
  REPLIED // Đã trả lời
  CLOSED // Đóng
  NEED_MORE_INFO // Yêu cầu bổ sung
  TRANSFERRED // Chuyển đơn vị
}

/// Phản ánh kiến nghị
model Feedback {
  id             String               @id @default(uuid())
  trackingCode   String               @unique @default(uuid()) // Mã tra cứu
  idempotencyKey String?              @unique // Chống gửi trùng
  citizenId      String
  citizen        Citizen              @relation(fields: [citizenId], references: [id])
  content        String               @db.Text
  category       String?
  attachments    FeedbackAttachment[]
  status         FeedbackStatus       @default(SUBMITTED)

  // Phân công
  handlerId String?
  handler   Admin?  @relation("FeedbackHandler", fields: [handlerId], references: [id])

  // Lịch sử
  replies       FeedbackReply[]
  statusHistory FeedbackStatusLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Tệp đính kèm phản ánh
model FeedbackAttachment {
  id         String   @id @default(uuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String   @db.Text
  fileSize   Int?
  mimeType   String?
  createdAt  DateTime @default(now())
}

/// Phản hồi của cán bộ
model FeedbackReply {
  id         String   @id @default(uuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id])
  content    String   @db.Text
  createdAt  DateTime @default(now())
}

/// Lịch sử trạng thái phản ánh — không ghi đè
model FeedbackStatusLog {
  id         String          @id @default(uuid())
  feedbackId String
  feedback   Feedback        @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  fromStatus FeedbackStatus?
  toStatus   FeedbackStatus
  note       String?         @db.Text
  changedBy  String? // Admin ID
  createdAt  DateTime        @default(now())
}

// ============================================================
// NHẬT KÝ KIỂM TOÁN
// ============================================================

/// Nhật ký thao tác quan trọng
model AuditLog {
  id        String   @id @default(uuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id])
  action    String // vd: "POST_PUBLISH", "FEEDBACK_ASSIGN"
  resource  String // vd: "post:abc-123"
  detail    Json? // Metadata bổ sung (không chứa dữ liệu nhạy cảm)
  ip        String?
  createdAt DateTime @default(now())
}

// ============================================================
// LẤY SỐ THỨ TỰ VÀ ĐẶT LỊCH HẸN
// Quy tắc nghiệp vụ: docs/queue-appointment-rules.md
// Mọi giá trị hạn mức để trống (NULL) = chưa được Trung tâm duyệt.
// ============================================================

/// Trạng thái số thứ tự
enum TicketStatus {
  WAITING // Đã cấp, đang chờ
  CALLING // Đang gọi
  SERVING // Đang phục vụ
  COMPLETED // Hoàn tất
  CANCELLED // Đã hủy
  NO_SHOW // Vắng mặt
  TRANSFERRED // Đã chuyển quầy
}

/// Nguồn cấp số
enum TicketSource {
  ONLINE // Người dân lấy trên Mini App
  WALK_IN // Cán bộ cấp trực tiếp tại quầy
  APPOINTMENT // Phát sinh khi check-in lịch hẹn
  TRANSFER // Phát sinh khi chuyển quầy
}

/// Trạng thái lịch hẹn
enum AppointmentStatus {
  CONFIRMED // Đã xác nhận
  CHECKED_IN // Đã check-in (đã có số trong hàng chờ)
  COMPLETED // Hoàn tất
  CANCELLED // Đã hủy
  RESCHEDULED // Đã đổi sang lịch khác (giữ lịch sử)
  NO_SHOW // Vắng mặt
}

/// Quầy phục vụ — một hàng chờ cho mỗi quầy
model ServiceCounter {
  id          String  @id @default(uuid())
  code        String  @unique @db.VarChar(8) // Tiền tố số hiển thị, vd "A"
  name        String  @db.VarChar(120)
  description String? @db.Text

  // Mặc định tắt; chỉ bật khi đủ cấu hình bắt buộc
  isActive           Boolean @default(false)
  ticketEnabled      Boolean @default(false)
  appointmentEnabled Boolean @default(false)

  // Hạn mức — NULL = chưa được duyệt
  dailyCapacity                   Int?
  ticketQuota                     Int?
  appointmentQuota                Int?
  walkInQuota                     Int?
  slotMinutes                     Int?
  slotCapacity                    Int?
  bookingMinLeadMinutes           Int?
  bookingMaxDaysAhead             Int?
  maxActiveTicketsPerCitizen      Int?
  maxActiveAppointmentsPerCitizen Int?

  fields       CounterField[]
  schedules    CounterSchedule[]
  closures     CounterClosure[]
  staff        CounterStaff[]
  days         CounterDay[]
  tickets      QueueTicket[]
  appointments Appointment[]
  events       QueueEvent[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

/// Lĩnh vực → quầy phụ trách. Mỗi lĩnh vực chỉ thuộc một quầy.
model CounterField {
  id        String         @id @default(uuid())
  counterId String
  counter   ServiceCounter @relation(fields: [counterId], references: [id], onDelete: Cascade)
  fieldId   String         @unique
  field     ProcedureField @relation(fields: [fieldId], references: [id])
  createdAt DateTime       @default(now())

  @@index([counterId])
}

/// Giờ hoạt động theo thứ trong tuần (0 = Chủ nhật … 6 = Thứ bảy); nhiều khoảng mỗi ngày
model CounterSchedule {
  id        String         @id @default(uuid())
  counterId String
  counter   ServiceCounter @relation(fields: [counterId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String         @db.VarChar(5) // HH:mm
  endTime   String         @db.VarChar(5) // HH:mm

  @@unique([counterId, weekday, startTime])
}

/// Ngày nghỉ/đóng quầy
model CounterClosure {
  id        String         @id @default(uuid())
  counterId String
  counter   ServiceCounter @relation(fields: [counterId], references: [id], onDelete: Cascade)
  date      DateTime       @db.Date
  note      String?        @db.VarChar(200)
  createdAt DateTime       @default(now())

  @@unique([counterId, date])
}

/// Phân công cán bộ quầy
model CounterStaff {
  id        String         @id @default(uuid())
  counterId String
  counter   ServiceCounter @relation(fields: [counterId], references: [id], onDelete: Cascade)
  adminId   String
  admin     Admin          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([counterId, adminId])
}

/// Dòng khóa theo quầy/ngày: tuần tự hóa cấp số và giữ chỗ trong transaction
model CounterDay {
  id           String         @id @default(uuid())
  counterId    String
  counter      ServiceCounter @relation(fields: [counterId], references: [id], onDelete: Cascade)
  serviceDate  DateTime       @db.Date
  lastSequence Int            @default(0)
  createdAt    DateTime       @default(now())

  @@unique([counterId, serviceDate])
}

/// Số thứ tự
model QueueTicket {
  id             String         @id @default(uuid())
  counterId      String
  counter        ServiceCounter @relation(fields: [counterId], references: [id])
  serviceDate    DateTime       @db.Date
  sequence       Int
  displayNumber  String         @db.VarChar(16)
  source         TicketSource
  status         TicketStatus   @default(WAITING)
  lookupCode     String         @unique @db.VarChar(16) // Mã tra cứu ngẫu nhiên, không chứa dữ liệu cá nhân
  idempotencyKey String?        @unique @db.VarChar(160)

  citizenId         String?
  citizen           Citizen?     @relation(fields: [citizenId], references: [id])
  fieldId           String?
  procedureId       String?
  procedure         Procedure?   @relation(fields: [procedureId], references: [id])
  appointmentId     String?
  appointment       Appointment? @relation(fields: [appointmentId], references: [id])
  transferredFromId String?

  callCount        Int       @default(0)
  calledAt         DateTime?
  servingAt        DateTime?
  finishedAt       DateTime?
  handledByAdminId String?
  version          Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([counterId, serviceDate, sequence])
  @@index([counterId, serviceDate, status, sequence])
  @@index([citizenId, serviceDate])
  @@index([appointmentId])
}

/// Lịch hẹn. slotSeat là "chỗ số N" của khung giờ; NULL khi lịch không còn giữ chỗ.
model Appointment {
  id             String            @id @default(uuid())
  counterId      String
  counter        ServiceCounter    @relation(fields: [counterId], references: [id])
  serviceDate    DateTime          @db.Date
  slotStart      String            @db.VarChar(5) // HH:mm
  slotSeat       Int?
  status         AppointmentStatus @default(CONFIRMED)
  lookupCode     String            @unique @db.VarChar(16)
  idempotencyKey String?           @unique @db.VarChar(160)

  citizenId    String
  citizen      Citizen    @relation(fields: [citizenId], references: [id])
  fieldId      String
  procedureId  String?
  procedure    Procedure? @relation(fields: [procedureId], references: [id])
  contactName  String     @db.VarChar(100)
  contactPhone String?    @db.VarChar(20)

  rescheduledFromId String?
  cancelReason      String?       @db.VarChar(200)
  version           Int           @default(0)
  tickets           QueueTicket[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Một chỗ của khung giờ chỉ được nhận một lần (NULL không xung đột)
  @@unique([counterId, serviceDate, slotStart, slotSeat])
  @@index([counterId, serviceDate, status])
  @@index([citizenId, status])
}

/// Lịch sử sự kiện — không ghi đè, không chứa dữ liệu cá nhân
model QueueEvent {
  id            String         @id @default(uuid())
  counterId     String
  counter       ServiceCounter @relation(fields: [counterId], references: [id])
  ticketId      String?
  appointmentId String?
  type          String         @db.VarChar(32)
  actorType     String         @db.VarChar(16) // ADMIN | CITIZEN | SYSTEM
  actorId       String?
  detail        Json?
  createdAt     DateTime       @default(now())

  @@index([counterId, createdAt])
  @@index([ticketId])
  @@index([appointmentId])
}

// ============================================================
// GÓP Ý NGƯỜI DÂN GỬI RIÊNG CHO TRUNG TÂM (KHÔNG YÊU CẦU ĐĂNG NHẬP)
// ============================================================

/// Nhóm đối tượng góp ý
enum CitizenFeedbackTarget {
  CENTER // Góp ý về Trung tâm
  MINI_APP // Góp ý về ứng dụng Mini App
  OTHER // Vấn đề khác
}

/// Trạng thái xử lý góp ý
enum CitizenFeedbackStatus {
  NEW // Mới tiếp nhận
  IN_PROGRESS // Đang xử lý
  RESOLVED // Đã hoàn tất xử lý
}

/// Trạng thái xác thực số điện thoại
enum PhoneVerificationStatus {
  UNVERIFIED // Do người gửi tự cung cấp, chưa xác thực OTP
}

/// Loại hành động trong lịch sử xử lý góp ý
enum CitizenFeedbackAction {
  CREATED // Người dân gửi góp ý mới
  ASSIGNED // Quản trị viên phân công cán bộ xử lý
  UNASSIGNED // Quản trị viên gỡ phân công
  STATUS_CHANGED // Chuyển trạng thái xử lý (NEW -> IN_PROGRESS -> RESOLVED)
  REOPENED // Quản trị viên mở lại góp ý (RESOLVED -> IN_PROGRESS)
  NOTE_ADDED // Thêm ghi chú nội bộ
}

/// Bản ghi góp ý riêng của người dân (không công khai)
model CitizenFeedback {
  id                      String                  @id @default(uuid())
  code                    String                  @unique @db.VarChar(24) // Mã góp ý duy nhất trả về cho người dân
  fullName                String                  @db.VarChar(120)
  phoneNormalized         String                  @db.VarChar(20)
  phoneVerificationStatus PhoneVerificationStatus @default(UNVERIFIED)
  target                  CitizenFeedbackTarget   @default(CENTER)
  content                 String                  @db.Text
  status                  CitizenFeedbackStatus   @default(NEW)

  assignedToId      String?
  assignedTo        Admin?    @relation("CitizenFeedbackAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolutionSummary String?   @db.Text
  resolvedAt        DateTime?

  idempotencyKey String? @unique @db.VarChar(128)
  payloadHash    String? @db.VarChar(64)

  history   CitizenFeedbackHistory[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([target, createdAt])
  @@index([assignedToId, status])
  @@index([createdAt])
}

/// Lịch sử xử lý góp ý — chỉ ghi thêm từ backend, không cho sửa/xóa tùy ý
model CitizenFeedbackHistory {
  id           String                 @id @default(uuid())
  feedbackId   String
  feedback     CitizenFeedback        @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  actorAdminId String?
  actorAdmin   Admin?                 @relation("CitizenFeedbackActor", fields: [actorAdminId], references: [id], onDelete: SetNull)
  action       CitizenFeedbackAction
  fromStatus   CitizenFeedbackStatus?
  toStatus     CitizenFeedbackStatus?
  note         String?                @db.Text
  createdAt    DateTime               @default(now())

  @@index([feedbackId, createdAt])
}

